# Local Postgres from infra/docker-compose.yml (`bun run infra:up`)
DATABASE_URL="postgres://slotty:slotty@localhost:5432/slotty"

# Public base URL used in emails (invite / reset links)
APP_URL="http://localhost:3000"

# SMTP — Mailpit from infra/ catches everything (inbox: http://localhost:8025).
# Leave SMTP_HOST empty to print emails to the worker console instead.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Slotty <no-reply@slotty.local>"

# Seeded platform admin
SEED_ADMIN_EMAIL="admin@slotty.local"
SEED_ADMIN_PASSWORD="admin12345"

# Web Push (PWA notifications). Generate once with: bunx web-push generate-vapid-keys
# Leave empty to disable push; everything else still works.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@slotty.local"
# Register the service worker under `next dev` too (it's always on in production builds).
# NEXT_PUBLIC_ENABLE_SW="1"

# Worker timing. Delivery wakes instantly via Postgres LISTEN/NOTIFY when available
# If LISTEN isn't available (e.g. behind a transaction-mode pooler), it polls every WORKER_INTERVAL_MS.
# WORKER_INTERVAL_MS="15000"
# WORKER_SCHEDULE_MS="60000"
