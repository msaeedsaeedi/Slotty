# Local Postgres from infra/docker-compose.yml (`bun run infra:up`)
DATABASE_URL="postgres://uniflow:uniflow@localhost:5432/uniflow"

# Public base URL used in emails (invite / reset links)
APP_URL="https://uniflow.local"

# SMTP — Mailpit from infra/ catches everything (inbox: http://localhost:8025).
# Leave SMTP_HOST empty (local development only) to skip sending: the worker notes recipient and
# subject, and /dev/mail shows the email. A deployment with a public APP_URL refuses to start without it.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Uniflow <no-reply@uniflow.local>"

# Seeded platform admin
SEED_ADMIN_EMAIL="admin@uniflow.local"
SEED_ADMIN_PASSWORD="admin12345"

# Web Push (PWA notifications). Generate once with: bunx web-push generate-vapid-keys
# Leave empty to disable push; everything else still works.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@uniflow.local"
# Register the service worker under `next dev` too (it's always on in production builds).
# NEXT_PUBLIC_ENABLE_SW="1"

# Worker timing. Delivery wakes instantly via Postgres LISTEN/NOTIFY when available
# If LISTEN isn't available (e.g. behind a transaction-mode pooler), it polls every WORKER_INTERVAL_MS.
# WORKER_INTERVAL_MS="15000"
# WORKER_SCHEDULE_MS="60000"

# Usage analytics (page views, speed, funnel steps, errors) is recorded only when this is set:
# it keys the pseudonymous visitor code. Leave it unset in dev and tests. Feedback and surveys
# work either way. Any long random string, e.g. `openssl rand -hex 32`.
# ANALYTICS_SECRET=""
# Release shown with events and feedback (AWS sets the image tag).
# APP_VERSION=""

# AWS deployment only (infra/aws): the secret CloudFront sends; requests without it get 403.
# Leave unset everywhere else.
# ORIGIN_VERIFY_SECRET=""
