# Local Postgres from `bunx prisma dev --name slotty --detach`
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# prisma dev (PGlite) handles one connection at a time; remove for a real Postgres server
DATABASE_POOL_MAX="1"

# Public base URL used in emails (invite / reset links)
APP_URL="http://localhost:3000"

# SMTP — leave SMTP_HOST empty to print emails to the worker console instead
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Slotty <no-reply@slotty.local>"

# Seeded platform admin
SEED_ADMIN_EMAIL="admin@slotty.local"
SEED_ADMIN_PASSWORD="admin12345"
