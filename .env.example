# Local Postgres from `bunx prisma dev --name slotty --detach`
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# prisma dev (PGlite) handles one connection at a time; remove for a real Postgres server
DATABASE_POOL_MAX="1"

# Public base URL used in emails (invite / reset links)
APP_URL="http://localhost:3000"

# SMTP — leave SMTP_HOST empty to print emails to the worker console instead
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Slotty <no-reply@slotty.local>"

# Seeded platform admin
SEED_ADMIN_EMAIL="admin@slotty.local"
SEED_ADMIN_PASSWORD="admin12345"

# Web Push (PWA notifications). Generate once with: bunx web-push generate-vapid-keys
# Leave empty to disable push; everything else still works.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@slotty.local"
# Register the service worker under `next dev` too (it's always on in production builds).
# NEXT_PUBLIC_ENABLE_SW="1"
