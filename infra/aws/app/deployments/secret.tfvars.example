# Copy to <deployment>.secret.tfvars (gitignored), e.g. uniflow.secret.tfvars.
alert_email = "you@example.com"

# slotty-prod only: the member account's admin role (output slotty_admin_role_arn of ../org).
# account_role_arn = "arn:aws:iam::<slotty-prod account id>:role/OrganizationAccountAccessRole"

# bunx web-push generate-vapid-keys. When moving production, copy slotty-prod's keys here
# (#137): existing push subscriptions only work with the same pair.
vapid_public_key  = ""
vapid_private_key = ""
