{
  "name": "slotty",
  "version": "1.0.0-beta.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "worker": "bun src/jobs/worker.ts",
    "admin:create": "bun src/jobs/create-admin.ts",
    "platform:grant": "bun src/jobs/platform-access.ts grant",
    "platform:revoke": "bun src/jobs/platform-access.ts revoke",
    "lint": "eslint",
    "audit": "bun audit --audit-level=high --ignore=GHSA-7589-6fvf-x4pw && cd docker/migrate && bun audit --audit-level=high --ignore=GHSA-7589-6fvf-x4pw",
    "typecheck": "next typegen && tsc --noEmit",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres mailpit caddy",
    "infra:cert": "docker compose -f infra/docker-compose.yml cp caddy:/data/caddy/pki/authorities/local/root.crt infra/caddy-root.crt",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "docs:build": "docs/tooling/build.sh",
    "docs:watch": "docs/tooling/build.sh -pvc",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "bun tests/e2e/run.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.1",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "testcontainers": "^12.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
