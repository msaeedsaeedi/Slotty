# Copy to deploy/.env on the server (never commit it). Compose reads it for both
# variable substitution and the app's environment.

# Public hostname; Caddy issues the certificate for it. APP_URL (for links in emails) is https://$DOMAIN.
DOMAIN="slotty.example.edu"

# Database password (generate: openssl rand -hex 24). DATABASE_URL is built from it in docker-compose.yml.
POSTGRES_PASSWORD=""

# SMTP from a mail provider (Resend, Postmark, SES, Brevo…). Port 465 uses TLS, 587 uses STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Slotty <no-reply@slotty.example.edu>"

# Web Push: generate once (bunx web-push generate-vapid-keys) and keep them — new keys break existing subscriptions.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@slotty.example.edu"
