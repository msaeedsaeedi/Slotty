generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// How clock times are shown to this user (12-hour "2:30 PM" or 24-hour "14:30").
enum TimeFormat {
  H12
  H24
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  passwordHash   String?
  isAdmin        Boolean    @default(false)
  /// Product team: sees usage insights and feedback at /platform. A dedicated
  /// account: never an admin, never in a course. Granted only from the command
  /// line (`bun run platform:grant`), never from the admin console.
  platformAccess Boolean    @default(false)
  status         UserStatus @default(INVITED)
  // The column "calendarToken" (the retired personal iCal feed, ADR-033) still exists in the
  // database, cleared, for the previous release; it is no longer modeled. `prisma migrate dev`
  // proposes dropping it: leave that out until the contract release.
  /// Email preferences (in-app notifications are always kept).
  emailReminders Boolean    @default(true)
  emailAgenda    Boolean    @default(true)
  /// Reminder on the morning of a demo day (email and push). Students only.
  remindMorning  Boolean    @default(true)
  /// Push reminder 10 minutes before a demo. Students only.
  remind10m      Boolean    @default(true)
  timeFormat     TimeFormat @default(H12)
  /// Last time the worker sent this staff member their daily agenda.
  agendaSentAt   DateTime?
  /// Share pseudonymous usage data (page views, timings, funnel steps). Errors and
  /// feedback are collected either way. See the privacy page.
  shareUsageData Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions          Session[]
  tokens            AuthToken[]
  enrollments       Enrollment[]
  coursesCreated    Course[]            @relation("CourseCreator")
  slotsHosted       Slot[]              @relation("SlotTA")
  blocks            AvailabilityBlock[]
  bookings          Booking[]           @relation("BookingStudent")
  cancellations     Booking[]           @relation("BookingCancelledBy")
  evaluations       Evaluation[]        @relation("EvaluationStudent")
  evaluated         Evaluation[]        @relation("EvaluationEvaluator")
  reviewed          Evaluation[]        @relation("EvaluationReviewer")
  submitted         Evaluation[]        @relation("EvaluationSubmitter")
  evaluationNotes   EvaluationNote[]    @relation("EvaluationNoteAuthor")
  notifications     Notification[]
  auditLogs         AuditLog[]
  allowances        BookingAllowance[]  @relation("AllowanceStudent")
  allowancesGiven   BookingAllowance[]  @relation("AllowanceGrantedBy")
  waitlist          WaitlistEntry[]
  requests          StudentRequest[]    @relation("RequestStudent")
  requestsHandled   StudentRequest[]    @relation("RequestResolvedBy")
  pushSubscriptions PushSubscription[]
  surveyPrompts     SurveyPrompt[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]

  @@index([userId])
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum AuthAttemptKind {
  SIGN_IN_FAILURE
  RESET_REQUEST
  RESET_EMAIL
}

/// Recent sign-in failures and reset requests, for the abuse limits in
/// `src/domain/auth-limits.ts`. `keyHash` is a SHA-256 of "account:<email>" or
/// "network:<ip>", never the value itself. The worker deletes rows after a day.
model AuthAttempt {
  id        String          @id @default(cuid())
  kind      AuthAttemptKind
  keyHash   String
  createdAt DateTime        @default(now())

  @@index([kind, keyHash, createdAt])
  @@index([createdAt])
}

// ─── Courses ─────────────────────────────────────────────────────────────────

enum CourseRole {
  INSTRUCTOR
  TA
  STUDENT
}

model Course {
  id          String   @id @default(cuid())
  code        String
  title       String
  term        String
  timezone    String   @default("Asia/Karachi")
  archived    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User         @relation("CourseCreator", fields: [createdById], references: [id])
  enrollments Enrollment[]
  venues      Venue[]
  assignments Assignment[]
}

model Enrollment {
  id        String     @id @default(cuid())
  courseId  String
  userId    String
  role      CourseRole
  section   String?
  createdAt DateTime   @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model Venue {
  id         String   @id @default(cuid())
  courseId   String
  name       String
  location   String?
  meetingUrl String?
  createdAt  DateTime @default(now())
  /// When this row last changed: part of the offline page versions (#162).
  updatedAt  DateTime @default(now()) @updatedAt

  course Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slots  Slot[]
  blocks AvailabilityBlock[]
}

// ─── Assignments & scheduling ────────────────────────────────────────────────

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Assignment {
  id          String           @id @default(cuid())
  courseId    String
  title       String
  description String           @default("")
  maxMarks    Float
  status      AssignmentStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  criteria    RubricCriterion[]
  policy      DemoPolicy?
  allowances  BookingAllowance[]
  waitlist    WaitlistEntry[]
  requests    StudentRequest[]
  blocks      AvailabilityBlock[]
  slots       Slot[]
  bookings    Booking[]
  evaluations Evaluation[]

  @@index([courseId])
}

model RubricCriterion {
  id           String   @id @default(cuid())
  assignmentId String
  label        String
  maxPoints    Float
  order        Int
  /// When this row last changed: part of the offline page versions (#162).
  updatedAt    DateTime @default(now()) @updatedAt

  assignment Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scores     EvaluationScore[]
}

model DemoPolicy {
  assignmentId       String    @id
  windowStart        DateTime
  windowEnd          DateTime
  slotDurationMin    Int
  bufferMin          Int       @default(0)
  capacityPerSlot    Int       @default(1)
  bookingOpensAt     DateTime?
  freezeHours        Int       @default(12)
  maxReschedules     Int       @default(2)
  allowStudentCancel Boolean   @default(true)
  /// When students were told booking is open (set on publish, or by the worker at bookingOpensAt).
  openAnnouncedAt    DateTime?
  /// When unbooked students were nudged that the demo window is about to end.
  nudgeSentAt        DateTime?
  /// When this row last changed: part of the offline page versions (#162).
  updatedAt          DateTime  @default(now()) @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

/// A TA's availability window; the system slices it into slots.
model AvailabilityBlock {
  id           String   @id @default(cuid())
  assignmentId String
  taId         String
  venueId      String?
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  ta         User       @relation(fields: [taId], references: [id])
  venue      Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  slots      Slot[]
}

enum SlotStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Slot {
  id           String     @id @default(cuid())
  assignmentId String
  blockId      String?
  taId         String
  venueId      String?
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int
  status       SlotStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  /// When this row last changed: part of the offline page versions (#162).
  updatedAt    DateTime   @default(now()) @updatedAt

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  block      AvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  ta         User               @relation("SlotTA", fields: [taId], references: [id])
  venue      Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  bookings   Booking[]

  @@index([assignmentId, startsAt])
  @@index([taId, startsAt])
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Why a cancelled booking ended when a new one replaced it.
enum BookingChange {
  RESCHEDULED
  MOVED_BY_STAFF
}

/// At most one active (non-cancelled) booking per student per assignment is
/// enforced by the partial unique index `booking_one_active_per_student`
/// (see the init migration).
model Booking {
  id                String         @id @default(cuid())
  slotId            String
  assignmentId      String
  studentId         String
  status            BookingStatus  @default(BOOKED)
  cancelledAt       DateTime?
  cancelledById     String?
  /// The student cancelled with no changes left, so it didn't spend one; they
  /// can't book again themselves until staff grant more (`changeBudget`).
  freeCancel        Boolean        @default(false)
  /// Set on the old half of a reschedule or staff move, so history shows what
  /// happened instead of a plain "Cancelled".
  replacedBy        BookingChange?
  reminder24hAt     DateTime?
  reminder1hAt      DateTime?
  /// When the morning-of reminder was claimed (sent or skipped), so it goes out once.
  reminderMorningAt DateTime?
  /// When the 10-minute push reminder was claimed (sent or skipped).
  reminder10mAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  slot        Slot             @relation(fields: [slotId], references: [id], onDelete: Cascade)
  assignment  Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     User             @relation("BookingStudent", fields: [studentId], references: [id])
  cancelledBy User?            @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  evaluation  Evaluation?
  requests    StudentRequest[]

  @@index([slotId, status])
  @@index([studentId])
  @@index([assignmentId, studentId])
}

/// A staff-granted exception to an assignment's booking rules for one student.
model BookingAllowance {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  /// Changes (reschedules or cancellations) on top of the policy's maxReschedules.
  extraChanges Int      @default(0)
  /// May book or change even after booking has closed or before it opens.
  lateBooking  Boolean  @default(false)
  note         String?
  grantedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("AllowanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("AllowanceGrantedBy", fields: [grantedById], references: [id])

  @@unique([assignmentId, studentId])
}

/// "Tell me when a slot frees up" for an assignment with no free slots.
model WaitlistEntry {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

enum RequestKind {
  /// Can't make my slot / need a different time (often inside the freeze window).
  BOOKING_CHANGE
  /// Question about released marks.
  MARK_QUERY
}

enum RequestStatus {
  OPEN
  RESOLVED
  DECLINED
}

/// A message from a student to course staff about one assignment.
model StudentRequest {
  id           String        @id @default(cuid())
  kind         RequestKind
  status       RequestStatus @default(OPEN)
  assignmentId String
  studentId    String
  bookingId    String?
  message      String
  response     String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("RequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  booking    Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resolvedBy User?      @relation("RequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([assignmentId, status])
  @@index([studentId])
}

// ─── Evaluation ──────────────────────────────────────────────────────────────

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  RETURNED
  FINALIZED
}

model Evaluation {
  id              String           @id @default(cuid())
  assignmentId    String
  studentId       String
  bookingId       String?          @unique
  evaluatorId     String
  totalMarks      Float?
  totalOverride   Boolean          @default(false)
  overrideNote    String?
  feedback        String?
  // The column "privateNotes" still exists in the database for the previous release (rollback)
  // but is no longer modeled, so no query can return it. Notes live in EvaluationNote (ADR-031).
  // `prisma migrate dev` proposes dropping it: leave that out until the contract release.
  /// Why staff marked a student who had no demo booking (unusual, so it's recorded).
  noBookingReason String?
  /// Why staff marked the demo before it started (also unusual, also recorded).
  earlyMarkReason String?
  status          EvaluationStatus @default(DRAFT)
  submittedAt     DateTime?
  /// Who submitted the marks last: the only TA who may withdraw them while they're held.
  submittedById   String?
  /// Held marks (ADR-032): a TA's submit in a course without an instructor stays SUBMITTED until
  /// this time, then the worker releases it. Null when nothing is held.
  releaseAt       DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewComment   String?
  /// The marks the student last saw ({totalMarks, feedback, scores}), kept while
  /// staff correct them after unlocking so the result doesn't vanish; cleared
  /// when the marks are released again.
  released        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignment  Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     User              @relation("EvaluationStudent", fields: [studentId], references: [id])
  booking     Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  evaluator   User              @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id])
  reviewedBy  User?             @relation("EvaluationReviewer", fields: [reviewedById], references: [id])
  submittedBy User?             @relation("EvaluationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  scores      EvaluationScore[]
  notes       EvaluationNote[]

  @@unique([assignmentId, studentId])
  @@index([status, releaseAt])
}

/// A staff member's private note on one evaluation (ADR-031). Readable only by its author and
/// the course's enrolled instructors (`canReadPrivateNote`), never by students or admins, and
/// never part of exports, emails or push. Loaded on its own, never through Evaluation.
model EvaluationNote {
  id           String   @id @default(cuid())
  evaluationId String
  /// Null for notes written before notes had authors: only the course's instructors read those.
  authorId     String?
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  author     User?      @relation("EvaluationNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([evaluationId, authorId])
  @@index([authorId])
}

model EvaluationScore {
  id           String  @id @default(cuid())
  evaluationId String
  criterionId  String
  points       Float
  comment      String?

  evaluation Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
}

// ─── Notifications & audit ───────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  /// Items about the same thing (one booking, one set of marks) share a key, so
  /// a quick follow-up replaces an unread earlier one instead of stacking (`notify`).
  groupKey  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, groupKey])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Transactional outbox: rows are written in the same transaction as the change
/// that triggers them and delivered by the worker (`bun run worker`).
model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String?
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sendAfter DateTime    @default(now())
  sentAt    DateTime?
  /// Same as Notification.groupKey: a pending (delayed) email is replaced by a newer one with the same key.
  groupKey  String?
  createdAt DateTime    @default(now())

  @@index([status, sendAfter])
  @@index([groupKey])
}

/**
 * A browser/device that accepted push notifications. Tied to the login session
 * that created it, so signing out (or any session removal) stops pushes to it.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages PushMessage[]

  @@index([userId])
}

/// Push outbox: written with the notification, delivered by the worker.
model PushMessage {
  id             String      @id @default(cuid())
  subscriptionId String
  title          String
  body           String
  link           String?
  /// After this the push is useless (a reminder for a demo that has started): sent with a
  /// TTL that ends here, and dropped instead of sent once it has passed. Null: 1 hour TTL.
  expiresAt      DateTime?
  /// Sent with `Urgency: high`, so phones in battery saving deliver it now (reminders).
  urgent         Boolean     @default(false)
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())

  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ─── Usage analytics & feedback ──────────────────────────────────────────────
// First-party only (ADR-015). Nothing here names a user: `visitor` is a keyed
// hash of the user id, and feedback and survey answers carry no user at all.

/// One client event (see `src/domain/analytics.ts` for the catalog). Raw rows are
/// kept 90 days; `AnalyticsDaily` keeps the daily totals for 13 months.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  occurredAt DateTime @default(now())
  name       String
  /// HMAC-SHA256(user id, ANALYTICS_SECRET), truncated. Null for opted-out users' errors.
  visitor    String?
  /// Random per browser tab, so funnels can follow one visit.
  sessionId  String
  /// student, staff, both or admin.
  role       String
  /// Route template, e.g. /courses/:id/assignments/:id (never a real id or token).
  path       String
  /// mobile, tablet or desktop.
  device     String
  version    String
  props      Json?

  @@index([occurredAt])
  @@index([name, occurredAt])
}

/// Daily totals per event, path, role and device (written by the worker).
model AnalyticsDaily {
  day      DateTime @db.Date
  name     String
  path     String
  role     String
  device   String
  events   Int
  visitors Int
  /// 75th percentile of `props.value` for web-vital events.
  p75      Float?

  @@id([day, name, path, role, device])
}

enum FeedbackStatus {
  NEW
  TRIAGED
  DONE
}

/// Anonymous feedback from the in-app button. No user id, by design; `createdAt`
/// is rounded to the hour so it can't be matched against usage events.
model Feedback {
  id        String         @id @default(cuid())
  message   String
  rating    Int?
  path      String
  role      String
  version   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
}

/// An answer to a one-question survey (score null = dismissed). Anonymous;
/// `createdAt` is the UTC day only.
model SurveyResponse {
  id        String   @id @default(cuid())
  prompt    String
  score     Int?
  role      String
  version   String
  createdAt DateTime @default(now())

  @@index([prompt, createdAt])
}

/// When a user was last asked a survey prompt: enforces "at most once per 14
/// days". It records that they were asked, never what they answered (and no
/// answer time, which could be matched against the response).
model SurveyPrompt {
  userId   String
  prompt   String
  shownAt  DateTime
  answered Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, prompt])
}
